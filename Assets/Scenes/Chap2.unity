  m_Name: 
  m_EditorClassIdentifier: Unity.TextMeshPro::TMPro.TextMeshProUGUI
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "<align=center>\r\n<size=135%><b><color=#111111>\uB3D9\uCABD \uBD81\uBD80
    \uBCF4\uC870 \uC804\uB825 \uC791\uB3D9 \uC808\uCC28</color></b></size>\r\n</align><align=left>\r\n<size=90%><color=#333333>\r\n\uB3D9\uBD80
    \uBD81\uCABD \uAD6C\uC5ED\uC758 \uC81C\uC5B4 \uD328\uB110\uC5D0\uB294 <b>\uBE5B\uC758
    \uACA9\uC790 \uC7A5\uCE58</b>\uAC00 \uC124\uCE58\uB418\uC5B4 \uC788\uC2B5\uB2C8\uB2E4. 
    \r\n\uAC01 \uBC84\uD2BC\uC744 \uB204\uB97C \uB54C\uB9C8\uB2E4,  \r\n\uADF8 \uCE78\uACFC
    <b>\uC0C1\uD558\uC88C\uC6B0 \uC778\uC811\uD55C \uCE78</b>\uC758 \uBD88\uBE5B\uC774
    <b>\uAEBC\uC9C0\uAC70\uB098 \uCF1C\uC9D1\uB2C8\uB2E4</b>.  \r\n\r\n<b>\uBAA8\uB4E0
    \uBD88\uBE5B\uC744 \uCF1C\uBA74</b> \uC8FC \uC804\uB825\uC774 \uC644\uC804\uD788
    \uBCF5\uAD6C\uB429\uB2C8\uB2E4.\r\n</color></size><line-height=120%>\r\n\uC608\uC2DC) 
    \r\n\uD55C \uCE78\uC744 \uB20C\uB800\uC744 \uB54C \uC8FC\uBCC0 \uBD88\uBE5B\uC774
    \uBC18\uC751\uD558\uBA70 \uD328\uD134\uC774 \uBC14\uB01D\uB2C8\uB2E4.  \r\n\uBAA8\uB4E0
    \uCE78\uC774 \uBC1D\uAC8C \uBE5B\uB0A0 \uB54C\uAE4C\uC9C0 \uC870\uC791\uD558\uC2ED\uC2DC\uC624.\r\n</line-height>\r\n\r\n<size=90%><color=#222222>\uBAA8\uB4E0
    \uBD88\uBE5B\uC774 \uCF1C\uC9C4 \uC0C1\uD0DC\uAC00 \uB418\uBA74 <b>\uB3D9\uBD80
    \uBD81\uCABD \uBCF4\uC870 \uC804\uB825</b>\uC774 \uD65C\uC131\uD654\uB429\uB2C8\uB2E4.</color></size>\r\n</align>\r\n<align=right><size=80%><i><color=#555555>-
    \uC548\uC804 \uAD00\uB9AC\uC790</color></i></size>\r\n</align>\r\n"
  m_isRightToLeft: 0
